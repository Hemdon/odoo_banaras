<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_program_form_banaras_branch" model="ir.ui.view">
        <field name="name">loyalty.program.form.banaras.branch</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='program_type']" position="after">
                <field name="x_banaras_branch_loyalty"
                       invisible="program_type != 'loyalty'"/>
            </xpath>
        </field>
    </record>
</odoo>
